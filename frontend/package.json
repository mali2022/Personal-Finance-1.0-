{
  "name": "personal-finance",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "build": "node scripts/validate-releases.mjs && tsc -b && vite build --configLoader runner",
    "test": "vitest run --configLoader runner",
    "lint": "eslint .",
    "format": "prettier --write .",
    "e2e": "playwright test",
    "dev:api": "vite --configLoader runner --mode integration --host 127.0.0.1 --port 5174 --strictPort",
    "e2e:api": "playwright test --config playwright.integration.config.ts",
    "preview": "vite preview --configLoader runner --host 127.0.0.1 --port 4173",
    "typecheck": "tsc -b",
    "verify:build": "node scripts/verify-build.mjs",
    "check:ds": "node scripts/check-ds.mjs",
    "visual": "playwright test --config playwright.visual.config.ts",
    "docs:source": "node scripts/source-book.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@tanstack/react-query": "^5.90.0",
    "antd": "^5.27.0",
    "axios": "^1.12.0",
    "dayjs": "^1.11.13",
    "echarts": "^6.0.0",
    "katex": "^0.19.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tesseract.js": "6.0.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "msw": "^2.11.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
