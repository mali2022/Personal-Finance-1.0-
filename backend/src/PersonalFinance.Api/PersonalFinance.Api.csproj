<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>PersonalFinance-DeepSeek-Server</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../../frontend/src/data/currencies.json" LogicalName="PersonalFinance.CurrencyCatalog.json" />
    <EmbeddedResource Include="../../../frontend/src/data/releases.json" LogicalName="PersonalFinance.ReleaseCatalog.json" />
    <Content Include="../../../frontend/src/data/releases.json" Link="release-info.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Remove="appsettings.Local.json;*credentials.local.json;.keys/**" />
    <!-- 默认分类树：编译进程序集，运行期不依赖文件路径（Web SDK 默认会把 *.json 当 Content） -->
    <Content Remove="Infrastructure/DefaultCategories.json" />
    <EmbeddedResource Include="Infrastructure/DefaultCategories.json" />
    <Content Remove="Infrastructure/DefaultProductPrices.json" />
    <EmbeddedResource Include="Infrastructure/DefaultProductPrices.json" />
    <Content Remove="Infrastructure/DefaultTags.json" />
    <EmbeddedResource Include="Infrastructure/DefaultTags.json" />
    <Content Remove="Infrastructure/PayrollTaxTemplate.json" />
    <EmbeddedResource Include="Infrastructure/PayrollTaxTemplate.json" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <!-- Override the runtime's older assembly with the patched .NET 10 release. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <!-- SkiaSharp 主包只带 Windows/macOS 原生库；Linux 上 NormalizeAvatar 的 SKBitmap.Decode
         会因缺少 libSkiaSharp 抛 DllNotFoundException（表现为头像上传 500）。
         NoDependencies 变体自带不依赖系统 fontconfig 的 .so，适合 aspnet 精简镜像。 -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
  </ItemGroup>
</Project>
